# --- Database ---
DATABASE_URL=postgres://user:password@host:5432/dealworld
# If using Supabase, use the connection string from Project Settings > Database

# --- Server ---
PORT=3000
BASE_URL=https://your-deployed-domain.com
DEALWORLD_TIMEZONE=America/Los_Angeles

# --- Gmail (Google Cloud OAuth, free tier) ---
# Create a project at console.cloud.google.com, enable the Gmail API,
# create OAuth credentials (type: Web application), and add BASE_URL/auth/gmail/callback
# as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-deployed-domain.com/auth/gmail/callback
# Filled in automatically after you complete the one time OAuth flow at /auth/gmail
GOOGLE_REFRESH_TOKEN=
GMAIL_SEND_AS_ADDRESS=you@yourdomain.com

# --- BoldSign ---
BOLDSIGN_API_KEY=
BOLDSIGN_NDA_TEMPLATE_ID=
BOLDSIGN_MARKETING_AGREEMENT_TEMPLATE_ID=
BOLDSIGN_APA_TEMPLATE_ID=
BOLDSIGN_WEBHOOK_SECRET=

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Drop Cowboy (ringless voicemail) ---
DROPCOWBOY_TEAM_ID=
DROPCOWBOY_SECRET=
DROPCOWBOY_BRAND_ID=

# Automated reminder emails (NDA reminders, gone quiet digest). Off unless "true".
REMINDER_EMAILS_ENABLED=false

# --- Calendly ---
CALENDLY_PERSONAL_ACCESS_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_LINK=https://calendly.com/dealmakermax/

# --- Fathom ---
FATHOM_API_KEY=

# --- Anthropic (AI drafting, reply classification, task detection) ---
ANTHROPIC_API_KEY=
